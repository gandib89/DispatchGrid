NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Migration/administrative connection. Prisma CLI uses this URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dispatchgrid?schema=public

# Restricted application connection. Runtime code uses this URL.
APP_DATABASE_URL=postgresql://dispatchgrid_app:dispatchgrid_app@localhost:5433/dispatchgrid?schema=public

REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters

# Optional integrations; leave blank during local foundation work.
GCS_PROJECT_ID=
GCS_UPLOAD_BUCKET=
SENTRY_DSN=
GEMINI_ENABLED=false
GEMINI_API_KEY=
